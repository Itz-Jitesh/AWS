# PlanProof AI service — example environment configuration.
# Copy to .env (never commit real credentials) or export before starting uvicorn.

# --- LLM backend -------------------------------------------------------------
# One of: mock | ollama | sagemaker. Empty is allowed: setting
# SAGEMAKER_ENDPOINT_NAME implies sagemaker; otherwise mock.
MODEL_BACKEND=sagemaker

# Required when MODEL_BACKEND=sagemaker (the endpoint you deployed).
SAGEMAKER_ENDPOINT_NAME=

# AWS region for the endpoint. Falls back to AWS_REGION / AWS_DEFAULT_REGION.
SAGEMAKER_REGION=us-east-1

# Model id reported/used. Defaults to google/gemma-4-E4B-it for sagemaker.
MODEL_ID=google/gemma-4-E4B-it

# Payload protocol spoken with the endpoint: planproof | hf | openai.
#   planproof = internal TRD envelope {prompt,diagnostics,max_tokens,model_id}
#               -> {patch,rationale,model_id,finish_reason}  (default; requires a
#               custom LMI input/output formatter — see SAGEMAKER_DEPLOYMENT_PLAN.md)
#   hf        = HuggingFace text-generation {inputs,parameters} -> {generated_text}
#   openai    = OpenAI chat {messages,...} -> {choices[0].message.content}
# The deployed endpoint's actual accepted format is a pre-deploy verification gate.
SAGEMAKER_PAYLOAD_MODE=planproof

# Invoke timeout in seconds (botocore read_timeout).
SAGEMAKER_TIMEOUT_S=120

# merged | adapter — provenance of the deployed weights (see integration doc).
MODEL_MODE=merged

# --- Ollama (local alternative backend) --------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_ID=gemma3

# --- Peers -------------------------------------------------------------------
# When set, the service uses real HTTP clients instead of in-process mocks.
# Leave empty for local development/tests (mock mode, reported by /capabilities).
WORKER_BASE_URL=
AUDIT_BASE_URL=

# --- Limits (defaults are the enforced safety caps) ---------------------------
LLM_MAX_TOKENS=2048
MAX_REPAIR_ATTEMPTS=3

# --- AWS credentials (SageMaker backend only) --------------------------------
# Provide via standard AWS chain (env, ~/.aws, instance role). NEVER commit.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=

# --- Live integration tests (SKIPPED otherwise) -------------------------------
# PLANPROOF_RUN_LIVE=1
