{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planproof.local/contracts/patch.schema.json",
  "title": "Patch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patch_id",
    "unified_diff",
    "rationale",
    "files_changed",
    "base_digest"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "patch_id": {
      "type": "string",
      "minLength": 1
    },
    "unified_diff": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "base_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
