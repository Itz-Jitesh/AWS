{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planproof.local/contracts/checkrun.schema.json",
  "title": "CheckRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "check_id",
    "tool",
    "status",
    "started_at",
    "duration_ms",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "check_id": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "Passed",
        "Failed",
        "Skipped",
        "NotConfigured",
        "UnableToVerify"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "string"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "tool_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "stdout_artifact": {
      "type": [
        "string",
        "null"
      ]
    },
    "stderr_artifact": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
