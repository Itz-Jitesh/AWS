# PlanProof — local-first configuration (copy to .env)
# No AWS credentials are required or used. All inference is localhost-only.

# Data roots (relative to the repository root)
PLANPROOF_DATA_DIR=./data
WORKER_DATA_DIR=./data/worker
PLANPROOF_ORCHESTRATION_DIR=./data/orchestration

# Python services (loopback only)
# WORKER_BASE_URL / AUDIT_BASE_URL are consumed by the AI service.
WORKER_BASE_URL=http://127.0.0.1:8081
AUDIT_BASE_URL=http://127.0.0.1:8083
PLANPROOF_WORKER_URL=http://127.0.0.1:8081
PLANPROOF_AI_URL=http://127.0.0.1:8082
PLANPROOF_AUDIT_URL=http://127.0.0.1:8083
WORKER_PORT=8081
AI_PORT=8082
AUDIT_PORT=8083
WEB_PORT=3000

# Local model runtime (Ollama). Keep MODEL_BACKEND explicit; mock mode is never
# used implicitly. MODEL_BACKEND=mock is only for tests and is labelled in the UI.
MODEL_BACKEND=ollama
MODEL_MODE=merged
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_ID=gemma4:e4b
OLLAMA_TIMEOUT_S=300
LLM_MAX_TOKENS=1024
MAX_REPAIR_ATTEMPTS=1

# Frontend backend selection: orchestration (default) | direct | mock
NEXT_PUBLIC_BACKEND=orchestration

# Optional absolute tool paths when not on PATH
# WORKER_TERRAFORM_BIN=/opt/homebrew/bin/terraform
# PLANPROOF_CHECKOV_BIN=/path/to/.venv/bin/checkov
# PLANPROOF_OPA_BIN=/opt/homebrew/bin/opa
# PLANPROOF_PYTHON=/path/to/.venv/bin/python
